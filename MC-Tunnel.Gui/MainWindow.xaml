<Window x:Class="MCTunnel.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MCTunnel.Gui.ViewModels"
        xmlns:models="clr-namespace:MCTunnel.Gui.Models"
        Title="MC-Tunnel"
        Width="500" Height="840" MinWidth="480" MinHeight="840" MaxHeight="840"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="{StaticResource McUIFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="12,0,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Border Height="6" Background="{StaticResource GrassStripBrush}" VerticalAlignment="Top"/>
            <Border Height="2" VerticalAlignment="Top" Margin="0,4,0,0" Background="#6B4423"/>
            <StackPanel Margin="0,12,0,4" HorizontalAlignment="Center">
                <TextBlock Text="MC-Tunnel" FontSize="22" FontWeight="Bold" Foreground="#E8F0E8" HorizontalAlignment="Center"/>
                <TextBlock Text="Minecraft 流量伪装代理" Style="{StaticResource McHint}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Connection -->
        <Border Grid.Row="1" Style="{StaticResource McPanel}" Padding="12,10" Margin="0,0,0,6">
            <StackPanel>
                <TextBlock Text="连接设置" Style="{StaticResource McSectionTitle}" Margin="0,0,0,8"/>
                <TextBlock Text="MC 服务器（例: 你的IP:25565）" Style="{StaticResource McLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Remote, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource McTextBox}" IsEnabled="{Binding CanEdit}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="本地 SOCKS5" Style="{StaticResource McLabel}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding LocalProxy, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource McTextBox}" IsEnabled="{Binding CanEdit}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="速度" Style="{StaticResource McLabel}" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource McComboBox}" IsEnabled="{Binding CanEdit}" SelectedItem="{Binding Speed}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource SpeedDisplay}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <models:SpeedMode>Turbo</models:SpeedMode>
                            <models:SpeedMode>Fast</models:SpeedMode>
                            <models:SpeedMode>Balanced</models:SpeedMode>
                            <models:SpeedMode>Stealth</models:SpeedMode>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <CheckBox Content="连接后自动设置系统代理" Style="{StaticResource McCheckBox}"
                          IsChecked="{Binding SetSystemProxy}" IsEnabled="{Binding CanEdit}"/>
            </StackPanel>
        </Border>

        <!-- Routing + whitelist -->
        <Border Grid.Row="2" Style="{StaticResource McPanel}" Padding="12,10" Margin="0,0,0,6">
            <StackPanel>
                <TextBlock Text="分流模式" Style="{StaticResource McSectionTitle}" Margin="0,0,0,6"/>
                <UniformGrid Columns="3" IsEnabled="{Binding CanEdit}" Margin="0,0,0,4">
                    <RadioButton Content="全部代理" Style="{StaticResource McModeTab}" GroupName="Mode"
                                 IsChecked="{Binding ProxyMode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ProxyMode.All}}"/>
                    <RadioButton Content="国外 IP" Style="{StaticResource McModeTab}" GroupName="Mode"
                                 IsChecked="{Binding ProxyMode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ProxyMode.GfwOnly}}"/>
                    <RadioButton Content="全部直连" Style="{StaticResource McModeTab}" GroupName="Mode"
                                 IsChecked="{Binding ProxyMode, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ProxyMode.Direct}}"/>
                </UniformGrid>
                <TextBlock Text="{Binding ModeDescription}" Style="{StaticResource McHint}" Margin="0,0,0,2"/>

                <StackPanel Visibility="{Binding ShowWhitelist, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0">
                    <TextBlock Text="白名单（国内也走代理）" Style="{StaticResource McLabel}" Margin="0,0,0,4"/>
                    <Grid IsEnabled="{Binding CanEdit}" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource McTextBox}" Text="{Binding NewWhitelistDomain, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Grid.Column="1" Content="子域" Margin="8,0,0,0" Style="{StaticResource McCheckBox}" VerticalAlignment="Center"
                                  IsChecked="{Binding NewWhitelistSubdomains}"/>
                        <Button Grid.Column="2" Content="添加" Margin="6,0,0,0" Style="{StaticResource McSmallButton}" Command="{Binding AddWhitelistCommand}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Whitelist}" MaxHeight="52">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Domain}" Style="{StaticResource McLabel}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="删" Style="{StaticResource McSmallButton}" Padding="8,2"
                                            Command="{Binding DataContext.RemoveWhitelistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Connect -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Height="42" Command="{Binding ToggleConnectCommand}"
                    IsEnabled="{Binding IsConnectButtonEnabled}"
                    Content="{Binding ConnectButtonText}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource McPrimaryButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UseDangerButton}" Value="True">
                                <Setter Property="Background" Value="#A83838"/>
                                <Setter Property="BorderBrush" Value="#E07070"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                <Setter Property="Opacity" Value="0.65"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Border Grid.Column="1" Margin="10,0,0,0" MinWidth="96" Background="#121216" BorderBrush="#3A3A42" BorderThickness="2" Padding="12,6">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="状态" Style="{StaticResource McHint}" FontSize="10" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" HorizontalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,5,0" Fill="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusText}}" Style="{StaticResource McLabel}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Traffic -->
        <Border Grid.Row="4" Style="{StaticResource McPanel}" Padding="12,8" Margin="0,0,0,6"
                Visibility="{Binding Status, Converter={StaticResource TrafficVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#0A0A0E" BorderBrush="#08080A" BorderThickness="2" Padding="10,6">
                    <StackPanel>
                        <TextBlock Text="↑ 上行" Style="{StaticResource McHint}" FontSize="10"/>
                        <TextBlock Text="{Binding UploadSpeed}" Foreground="#7EC8E3" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding UploadTotal, StringFormat=累计 {0}}" Style="{StaticResource McHint}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#0A0A0E" BorderBrush="#08080A" BorderThickness="2" Padding="10,6">
                    <StackPanel>
                        <TextBlock Text="↓ 下行" Style="{StaticResource McHint}" FontSize="10"/>
                        <TextBlock Text="{Binding DownloadSpeed}" Foreground="#4ADE4A" FontSize="16" FontWeight="Bold" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding DownloadTotal, StringFormat=累计 {0}}" Style="{StaticResource McHint}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Logs fill remaining -->
        <Border Grid.Row="5" Style="{StaticResource McPanel}" Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="运行日志" Style="{StaticResource McSectionTitle}" Margin="0,0,0,6"/>
                <Border Grid.Row="1" Background="#0A0A0E" BorderBrush="#08080A" BorderThickness="2" MinHeight="72">
                    <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"
                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="11" Foreground="{StaticResource McLogGreen}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <TextBlock Grid.Row="2" Text="{Binding StatusHint}" Style="{StaticResource McHint}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Window>
